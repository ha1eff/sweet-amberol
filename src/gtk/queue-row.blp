using Gtk 4.0;

template $AmberolQueueRow: Widget {
  Stack row_stack {
    StackPage {
      name: "song-details";

      child: Box {
        Stack song_cover_stack {
          StackPage {
            name: "no-cover";

            child: Image {
              icon-name: "folder-music-symbolic";
              pixel-size: 32;

              styles [
                "dim-label",
                "card",
                "small",
              ]

              accessibility {
                label: C_("a11y", "No cover available");
              }
            };
          }

          StackPage {
            name: "cover";

            child: $AmberolCoverPicture song_cover_image {
              cover-size: "1";
              halign: "center";
              valign: "center";

              styles [
                "card",
              ]
            };
          }
        }

        Box {
          orientation: vertical;
          valign: center;
          hexpand: true;
          spacing: 3;

          Inscription song_title_label {
            xalign: 0;
            text-overflow: ellipsize_end;

            styles [
              "song-title",
            ]
          }

          Label song_artist_label {
            xalign: 0;
            halign: start;
            ellipsize: end;
            tooltip-text: _("Show artist");

            styles [
              "song-artist",
              "artist-link",
            ]
          }
        }

        [end]
        Box row_actions {
          orientation: horizontal;
          spacing: 2;
          halign: center;
          valign: center;

          Button favorite_button {
            icon-name: "non-starred-symbolic";
            halign: center;
            valign: center;
            width-request: 24;
            height-request: 24;
            tooltip-text: _("Add to Favorites");

            styles [
              "flat",
              "favorite-star",
            ]

            accessibility {
              label: C_("a11y", "Toggle favorite");
            }
          }

          Image song_playing_image {
            icon-name: "audio-only-symbolic";
            pixel-size: 16;
            halign: center;
            valign: center;
            opacity: 0;

            accessibility {
              label: C_("a11y", "Currently playing");
            }
          }
        }

        styles [
          "song-details",
        ]
      };
    }

    StackPage {
      name: "selection-mode";

      child: Box {
        CheckButton selected_button {
          halign: center;
          valign: center;

          styles [
            "selection-mode",
          ]
        }

        Box {
          orientation: vertical;
          valign: center;
          hexpand: true;
          spacing: 3;

          Inscription selection_title_label {
            xalign: 0;
            text-overflow: ellipsize_end;

            styles [
              "song-title",
            ]
          }

          Inscription selection_artist_label {
            xalign: 0;
            text-overflow: ellipsize_end;

            styles [
              "song-artist",
            ]
          }
        }

        [end]
        Box selection_row_actions {
          orientation: horizontal;
          spacing: 2;
          halign: center;
          valign: center;

          Button selection_favorite_button {
            icon-name: "non-starred-symbolic";
            halign: center;
            valign: center;
            width-request: 24;
            height-request: 24;
            tooltip-text: _("Add to Favorites");

            styles [
              "flat",
              "favorite-star",
            ]

            accessibility {
              label: C_("a11y", "Toggle favorite");
            }
          }

          Image selection_playing_image {
            icon-name: "audio-only-symbolic";
            pixel-size: 16;
            halign: center;
            valign: center;
            opacity: 0;
          }
        }

        styles [
          "song-details",
        ]
      };
    }
  }
}
