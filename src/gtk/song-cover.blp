using Gtk 4.0;

template $AmberolSongCover: Widget {
  Box {
    halign: center;
    valign: center;

    Overlay cover_overlay {
      child: Stack cover_stack {
        StackPage {
          name: "no-image";

          child: Image {
            overflow: hidden;
            icon-name: "folder-music-symbolic";
            pixel-size: 64;

            styles [
              "card",
              "dim-label",
            ]
          };
        }

        StackPage {
          name: "cover-image";

          child: $AmberolCoverPicture album_image {};
        }
      };

      [overlay]
      Revealer cover_button_revealer {
        transition-type: crossfade;
        transition-duration: 150;
        halign: end;
        valign: start;
        margin-top: 14;
        margin-end: 14;

        child: ToggleButton expand_button {
          icon-name: "view-fullscreen-symbolic";
          tooltip-text: _("Enlarge Cover");

          styles [
            "circular",
            "osd",
          ]

          accessibility {
            label: C_("a11y", "Enlarge cover");
          }
        };
      }
    }
  }
}